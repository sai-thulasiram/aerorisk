{
  // Static site + one Worker route (/api/lookup) that keeps the AeroDataBox key server-side.
  // Secret: npx wrangler secret put AERODATABOX_RAPIDAPI_KEY   (or Worker → Settings → Variables and Secrets)
  "name": "aerorisk",
  "main": "./worker/index.js",
  "compatibility_date": "2025-09-01",
  // Keep variables added in the Cloudflare dashboard when GitHub deploys (otherwise plain-text vars are wiped).
  "keep_vars": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/lookup", "/api/feedback", "/flights/*", "/sitemap-flights.xml", "/u/*"]
  },
  // Protect the API quota (AeroDataBox free tier is small). Only cache misses count.
  "ratelimits": [
    { "name": "LOOKUP_PER_IP", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
    { "name": "LOOKUP_GLOBAL", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "FEEDBACK_PER_IP", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }
  ],
  // Feedback storage. Read it at /api/feedback?token=<FEEDBACK_ADMIN_TOKEN> (secret; add &format=csv for a spreadsheet).
  // FLIGHTLOG keeps which aircraft each looked-up flight had (history table on /flights/... pages, flight sitemap).
  "durable_objects": { "bindings": [
    { "name": "FEEDBACK", "class_name": "FeedbackStore" },
    { "name": "FLIGHTLOG", "class_name": "FlightLog" }
  ] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FeedbackStore"] },
    { "tag": "v2", "new_sqlite_classes": ["FlightLog"] }
  ],
  "routes": [
    { "pattern": "myluckyseat.in", "custom_domain": true },
    { "pattern": "www.myluckyseat.in", "custom_domain": true }
  ],
  // Keep the old workers.dev address until SITE_URL points at myluckyseat.in, then set to false.
  "workers_dev": true,
  "observability": { "enabled": true }
}
