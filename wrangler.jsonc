{
  // Static site + one Worker route (/api/lookup) that keeps the AeroDataBox key server-side.
  // Secret: npx wrangler secret put AERODATABOX_RAPIDAPI_KEY   (or Worker → Settings → Variables and Secrets)
  "name": "aerorisk",
  "main": "./worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/lookup"]
  },
  // Protect the API quota (AeroDataBox free tier is small). Only cache misses count.
  "ratelimits": [
    { "name": "LOOKUP_PER_IP", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
    { "name": "LOOKUP_GLOBAL", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  // Uncomment once your domain is on Cloudflare (or add it in the dashboard instead):
  // "routes": [
  //   { "pattern": "yourdomain.com", "custom_domain": true },
  //   { "pattern": "www.yourdomain.com", "custom_domain": true }
  // ],
  "observability": { "enabled": true }
}
